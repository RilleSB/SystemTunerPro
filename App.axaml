<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiskCleanerGUI.Avalonia.App"
             xmlns:local="using:DiskCleanerGUI.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    
    <Application.Resources>
        <x:Double x:Key="DefaultFontSize">12</x:Double>
        <x:Double x:Key="ButtonFontSize">12</x:Double>
        <x:Double x:Key="HeaderFontSize">18</x:Double>
        <x:Double x:Key="LargeFontSize">24</x:Double>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DiskCleanerGUI.Avalonia/Styles/Controls.axaml"/>
        
        <!-- Global font size styles -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        </Style>
    </Application.Styles>
</Application>