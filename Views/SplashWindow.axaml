<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiskCleanerGUI.Avalonia.ViewModels"
        x:Class="DiskCleanerGUI.Avalonia.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Title="System Tuner Pro"
        Width="450" Height="280"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Background="Transparent">

  <!-- Главный контейнер с градиентным фоном -->
  <Border CornerRadius="15" BoxShadow="0 10 30 5 #40000000">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FF1e3c72" Offset="0"/>
        <GradientStop Color="#FF2a5298" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    
    <Grid RowDefinitions="*,Auto,Auto,Auto,*" Margin="40">
      
      <!-- Заголовок с анимацией появления -->
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" Opacity="0">
        <StackPanel.Styles>
          <Style Selector="StackPanel">
            <Style.Animations>
              <Animation Duration="0:0:0.8" FillMode="Forward">
                <KeyFrame Cue="0%">
                  <Setter Property="Opacity" Value="0"/>
                  <Setter Property="TranslateTransform.Y" Value="-20"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                  <Setter Property="Opacity" Value="1"/>
                  <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </StackPanel.Styles>
        
        <TextBlock Text="🧹💨 System Tuner Pro 💨⚙️" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center"/>
        <TextBlock Text="v2.1 - Ускоряем систему" 
                   FontSize="14" 
                   Foreground="#CCFFFFFF" 
                   HorizontalAlignment="Center" 
                   Margin="0,5,0,0"/>
      </StackPanel>

      <!-- Вращающаяся иконка загрузки -->
      <Border Grid.Row="2" 
              Width="60" Height="60" 
              Margin="0,30,0,20"
              HorizontalAlignment="Center">
        <Border.Styles>
          <Style Selector="Border">
            <Style.Animations>
              <Animation Duration="0:0:2" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                  <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                  <Setter Property="RotateTransform.Angle" Value="360"/>
                </KeyFrame>
              </Animation>
            </Style.Animations>
          </Style>
        </Border.Styles>
        
        <Border Background="#33FFFFFF" 
                CornerRadius="30" 
                BorderBrush="White" 
                BorderThickness="3">
          <TextBlock Text="⚡" 
                     FontSize="30" 
                     HorizontalAlignment="Center" 
                     VerticalAlignment="Center"/>
        </Border>
      </Border>

      <!-- Прогресс-бар с пульсацией -->
      <StackPanel Grid.Row="3" HorizontalAlignment="Center">
        <Border Width="300" Height="8" 
                Background="#33FFFFFF" 
                CornerRadius="4" 
                Margin="0,0,0,15">
          <Border Name="ProgressBar"
                  Background="White" 
                  CornerRadius="4"
                  HorizontalAlignment="Left"
                  Width="{Binding Progress, Converter={x:Static vm:ProgressToWidthConverter.Instance}}">
            <Border.Styles>
              <Style Selector="Border">
                <Style.Animations>
                  <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                      <Setter Property="Opacity" Value="0.8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                      <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Border.Styles>
          </Border>
        </Border>
        
        <!-- Текст загрузки с плавной сменой -->
        <TextBlock Text="{Binding LoadingText}" 
                   FontSize="16" 
                   Foreground="White" 
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold">
          <TextBlock.Styles>
            <Style Selector="TextBlock">
              <Style.Animations>
                <Animation Duration="0:0:0.3">
                  <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.6"/>
                  </KeyFrame>
                  <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                  </KeyFrame>
                </Animation>
              </Style.Animations>
            </Style>
          </TextBlock.Styles>
        </TextBlock>
      </StackPanel>
      
    </Grid>
  </Border>
</Window>