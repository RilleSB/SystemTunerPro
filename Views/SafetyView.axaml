<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskCleanerGUI.Avalonia.ViewModels"
             xmlns:ext="using:DiskCleanerGUI.Avalonia.Extensions"
             xmlns:local="using:DiskCleanerGUI.Avalonia.Converters"
             x:Class="DiskCleanerGUI.Avalonia.Views.SafetyView"
             x:DataType="vm:SafetyViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    
    <!-- Trash Management Section -->
    <Border Background="#AA2196F3" CornerRadius="12" Padding="20" Margin="0,0,0,16">
      <StackPanel Spacing="12">
        <TextBlock x:Name="SafetyTitle" Text="🗑️ Управление корзиной" FontSize="18" FontWeight="Bold" Foreground="White"/>
        
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="LoadTrashBtn" Content="{Binding LoadTrashText}" Command="{Binding LoadTrashCommand}" 
                  Background="#1976D2" Foreground="White" Padding="12,8" ToolTip.Tip="{Binding LoadTrashTooltipText}"/>
          <Button x:Name="EmptyTrashBtn" Content="{Binding EmptyTrashText}" Command="{Binding ClearTrashCommand}" 
                  Background="#F44336" Foreground="White" Padding="12,8" ToolTip.Tip="{Binding EmptyTrashTooltipText}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    
    <!-- Trash Items List -->
    <Border Grid.Row="1" Background="#AA101828" CornerRadius="8" Padding="12" Margin="0,0,0,16">
      <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="TrashFilesTitle" Text="📋 Файлы в корзине" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
        
        <ListBox Grid.Row="1" ItemsSource="{Binding TrashItems}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#22FFFFFF" CornerRadius="4" Padding="8" Margin="2">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding IsSystemRecycleBin, Converter={x:Static local:BoolToIconConverter.Instance}}" 
                             FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding OriginalPath}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="{Binding DeletedAt, StringFormat='Удален: {0:dd.MM.yyyy HH:mm}'}" Foreground="#B0B9CC" FontSize="11"/>
                      <TextBlock Text="{Binding Size, StringFormat='Размер: {0:N0} байт'}" Foreground="#B0B9CC" FontSize="11"/>
                      <TextBlock Text="{Binding IsSystemRecycleBin, Converter={x:Static local:BoolToTextConverter.Instance}}" 
                                 Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                  </StackPanel>
                  
                  <Button x:Name="RestoreBtn" Grid.Column="2" Content="{Binding $parent[UserControl].DataContext.RestoreFileText}" 
                          Command="{Binding $parent[UserControl].DataContext.RestoreFileCommand}" 
                          CommandParameter="{Binding}"
                          Background="#4CAF50" Foreground="White" Padding="8,4" FontSize="11" 
                          IsEnabled="{Binding IsSystemRecycleBin, Converter={x:Static local:InverseBoolConverter.Instance}}"
                          ToolTip.Tip="{Binding $parent[UserControl].DataContext.RestoreFileTooltipText}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    
    <!-- Status Bar -->
    <Border Grid.Row="2" Background="#DD000000" CornerRadius="8" Padding="12">
      <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
    </Border>
    
  </Grid>
</UserControl>