<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiskCleanerGUI.Avalonia.ViewModels"
             x:Class="DiskCleanerGUI.Avalonia.Views.LargeFilesView"
             x:DataType="vm:LargeFilesViewModel">

    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="📊 Поиск больших файлов" FontSize="18" FontWeight="Bold"/>
        
        <StackPanel Spacing="10">
            <TextBlock Text="Путь для сканирования:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding ScanPath}" Watermark="C:\"/>
            
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="👤 Профиль" Command="{Binding SelectUserProfileCommand}"/>
                <Button Content="📥 Загрузки" Command="{Binding SelectDownloadsCommand}"/>
                <Button Content="📄 Документы" Command="{Binding SelectDocumentsCommand}"/>
            </StackPanel>
        </StackPanel>
        
        <StackPanel Spacing="5">
            <TextBlock Text="Минимальный размер (MB):" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto">
                <Slider Minimum="10" Maximum="1000" Value="{Binding MinSizeMB}"/>
                <TextBlock Grid.Column="1" Text="{Binding MinSizeMB, StringFormat='{}{0} MB'}" Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="🔍 Начать поиск" Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}"/>
            <Button Content="❌ Отмена" Command="{Binding CancelCommand}" IsEnabled="{Binding IsScanning}"/>
        </StackPanel>
        
        <Border Background="#20000000" CornerRadius="5" Padding="10">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalSizeText}"/>
            </StackPanel>
        </Border>
        
        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Height="300">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SizeFormatted}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="📂 Открыть папку" Command="{Binding OpenFolderCommand}"/>
            <Button Content="🗑️ Удалить" Command="{Binding DeleteFileCommand}" Background="#D32F2F" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</UserControl>
